# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Ad-hoc browser-verification dumps (screenshots, console/accessibility logs).
# Verification itself belongs in commit messages / PROJECT_STATUS.md, not as
# binary artifacts in history.
.playwright-mcp/
frontend/.playwright-mcp/
.playwright-cli/
frontend/.playwright-cli/
audit/
motion-audits/

# skillui reconnaissance dumps (reference-site screenshots + raw computed
# styles, several MB of PNGs per site). The distilled findings — the only
# part meant to ship — live in docs/references/<site>/NOTES.md, tracked.
docs/references/*/skillui/

# Raw media build input (source screenshots/video for scripts/build-media.mjs,
# convert-work-shots.mjs, convert-product-video.mjs — hundreds of MB, one file
# alone over GitHub's 100MB limit). Output lives in public/media/ and is
# tracked; the raw source is not.
frontend/src/assets/

# npm lockfile — this project is managed with bun (frontend/bun.lock is the
# tracked lockfile); a stray package-lock.json is an npm-install byproduct.
frontend/package-lock.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Visual-QA screenshots (root-level scratch, never committed)
/*.png
